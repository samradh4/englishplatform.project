PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-this-with-a-long-random-secret
SESSION_DAYS=30
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-with-a-strong-password
MAX_ROOM_PARTICIPANTS=8
TOPIC_INTERVAL_MINUTES=10
VOICE_MODE=auto
VOICE_RELAY_SAMPLE_RATE=16000

# Persistent SQLite storage in production:
# Contabo example: DATA_DIR=/var/lib/boloenglish/data
# Render persistent-disk example: DATA_DIR=/var/data
# Optional explicit path: SQLITE_PATH=/var/lib/boloenglish/data/boloenglish.sqlite

# Optional TURN server. In auto mode, configured TURN uses WebRTC; otherwise the secure WSS relay is used for reliable remote demos.
# TURN_URL=turn:your-turn-server.example.com:3478
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-password

# Optional REAL conversational AI (OpenAI-compatible chat-completions endpoint).
# Without these, Bolo AI uses the improved local contextual conversation fallback.
# Keep the key on the server/Render environment only; never put it in browser JavaScript.
# AI_API_URL=https://your-provider.example/v1/chat/completions
# AI_API_KEY=your-private-api-key
# AI_MODEL=your-model-name
# AI_TIMEOUT_MS=15000
